{
  "rules": {
    ".read": false,
    ".write": false,

    "padelio_global_tournaments": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_archive_turnyrai": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_global_players": {
      ".read": true,
      "$pid": {
        ".write": "auth != null && (data.child('emailLocked').val() !== true || (newData.child('emailLocked').val() === true && newData.child('email').val() === data.child('email').val()) || data.child('email').val() === auth.token.email.toLowerCase())",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "emailLocked": { ".validate": "newData.isBoolean()" }
      }
    },

    "padelio_global_players_photos": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_email_links": {
      ".read": "auth != null",
      "$ek": {
        ".write": "auth != null && $ek === auth.token.email.toLowerCase().replace('.', ',')"
      }
    },

    "padelio_clubs": {
      ".read": true,
      "$clubId": {
        ".write": "auth != null && (root.child('padelio_clubs').child(root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val()).child('legacyOwner').val() === true || !data.exists() || data.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && (newData.child('legacyOwner').val() !== true || data.child('legacyOwner').val() === true) && (newData.child('canOfficial').val() !== true || data.child('canOfficial').val() === true || root.child('padelio_clubs').child(root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val()).child('legacyOwner').val() === true)"
      }
    },

    "padelio_club_admins": {
      ".read": true,
      "$ek": {
        ".write": "auth != null && ($ek === auth.token.email.toLowerCase().replace('.', ',') || root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val() === newData.child('clubId').val())"
      }
    },

    "padelio_user_clubs": {
      "$pid": {
        ".read": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid",
        ".write": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid"
      }
    },

    "padelio_user_tournaments": {
      "$pid": {
        ".read": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid",
        ".write": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid"
      }
    },

    "padelio_push_tokens": {
      "$pid": {
        ".read": false,
        ".write": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid"
      }
    },

    "padelio_push_sent": {
      ".read": "auth != null && root.child('padelio_clubs').child(root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val()).child('legacyOwner').val() === true",
      ".write": false
    },

    "padelio_backups_meta": {
      ".read": "auth != null && root.child('padelio_clubs').child(root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val()).child('legacyOwner').val() === true",
      ".write": false
    },

    "padelio_notifications": {
      "$pid": {
        ".read": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid",
        ".write": "auth != null && root.child('padelio_email_links').child(auth.token.email.toLowerCase().replace('.', ',')).val() === $pid"
      }
    },

    "padelio_room_seq": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "padelio_pro_master": {
      "$room": {
        ".read": true,
        ".write": "((auth != null && root.child('padelio_clubs').child(root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val()).child('legacyOwner').val() === true) || (data.child('owner/type').val() === 'club' ? (auth != null && root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val() === data.child('owner/clubId').val()) : (newData.child('owner/type').val() === 'club' ? (auth != null && root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val() === newData.child('owner/clubId').val()) : true))) && (newData.child('owner/official').val() !== true || data.child('owner/official').val() === true || root.child('padelio_clubs').child(newData.child('owner/clubId').val()).child('canOfficial').val() === true || root.child('padelio_clubs').child(newData.child('owner/clubId').val()).child('legacyOwner').val() === true)",
        "portal_links": { ".write": "auth != null" },
        "portal_links_by_name": { ".write": "auth != null" },
        "portal_links_reverse": { ".write": "auth != null" },
        "portal_links_retro": { ".write": "auth != null" },
        "lastUpdate": { ".write": "auth != null" },
        "matches": {
          "$idx": {
            "score1": { ".write": "auth != null" },
            "score2": { ".write": "auth != null" }
          }
        }
      }
    },

    "padelio_pro_master_rooms": {
      ".read": true,
      ".write": true,
      "$room": {
        ".validate": "newData.isNumber()"
      }
    },

    "padelio_pro_master_global_stats": {
      ".read": true,
      ".write": true,
      "visits": { ".validate": "newData.isNumber()" },
      "devices": {
        "$did": {
          ".validate": "newData.hasChildren(['type','lastSeen']) && newData.child('type').isString() && newData.child('type').val().length <= 16 && newData.child('lastSeen').isNumber()"
        }
      },
      "$other": { ".validate": false }
    },

    "padelio_rooms": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_webrtc_broadcasts": {
      ".read": true,
      ".write": true,
      "$bid": {
        "room": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "broadcaster": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "isPrivate": { ".validate": "newData.isBoolean()" },
        "startedAt": { ".validate": "newData.isNumber()" },
        "viewers": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "padelio_webrtc_signals": {
      ".read": true,
      ".write": true,
      "$bid": {
        "viewers": {
          "$vid": {
            "offer": {
              "type": { ".validate": "newData.isString() && newData.val().length <= 12" },
              "sdp": { ".validate": "newData.isString() && newData.val().length <= 65536" },
              "$o": { ".validate": false }
            },
            "answer": {
              "type": { ".validate": "newData.isString() && newData.val().length <= 12" },
              "sdp": { ".validate": "newData.isString() && newData.val().length <= 65536" },
              "$o": { ".validate": false }
            },
            "pin": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "rejected": { ".validate": "newData.isBoolean()" },
            "viewerCandidates": {
              "$c": { ".validate": "newData.hasChildren()" }
            },
            "broadcasterCandidates": {
              "$c": { ".validate": "newData.hasChildren()" }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "padelio_highlights": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_config": {
      ".read": true,
      ".write": false
    },

    "padelio_live_index": {
      ".read": true,
      ".write": "auth != null"
    },

    "padelio_chat": {
      "$clubId": {
        ".read": true,
        "$msgId": {
          ".write": "auth != null && (!data.exists() || root.child('padelio_club_admins').child(auth.token.email.toLowerCase().replace('.', ',')).child('clubId').val() === $clubId)",
          ".validate": "newData.hasChildren(['name','text','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('text').isString() && newData.child('text').val().length <= 500",
          "joined": {
            "$uid": {
              ".write": "auth != null",
              ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 60"
            }
          }
        }
      }
    }
  }
}
