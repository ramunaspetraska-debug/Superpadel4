rules_version = '2';

// SuperPadel Storage: naudojamas TIK highlight klipams (highlights/{turnyras}/{ts}.webm|mp4).
// Skaitymas viešas (klipais dalinamasi nuorodomis), rašymas — tik prisijungusiems,
// tik video failai iki 10 MB. Visa kita Storage erdvė uždaryta.
service firebase.storage {
  match /b/{bucket}/o {
    match /highlights/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
